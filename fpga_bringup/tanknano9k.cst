IO_LOC "clk" 52;
IO_PORT "clk" PULL_MODE = UP;

IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE = UP;

IO_LOC "rx" 18;
IO_PORT "rx" IO_TYPE = LVCMOS33;
IO_PORT "rx" PULL_MODE = UP;

IO_LOC "tx" 17;
IO_PORT "tx" IO_TYPE = LVCMOS33;

IO_LOC "busy" 10;
IO_PORT "busy" IO_TYPE = LVCMOS18;

// Debug: UART_Bridge FSM state (WAIT_CMD/WAIT_ADDR/WAIT_DATA/COMMIT/SEND),
// one bit per remaining onboard LED. Active-low, so the lit LED = current state.
IO_LOC "dbg_state[0]" 11;
IO_PORT "dbg_state[0]" IO_TYPE = LVCMOS18;

IO_LOC "dbg_state[1]" 13;
IO_PORT "dbg_state[1]" IO_TYPE = LVCMOS18;

IO_LOC "dbg_state[2]" 14;
IO_PORT "dbg_state[2]" IO_TYPE = LVCMOS18;

IO_LOC "dbg_state[3]" 15;
IO_PORT "dbg_state[3]" IO_TYPE = LVCMOS18;

IO_LOC "dbg_state[4]" 16;
IO_PORT "dbg_state[4]" IO_TYPE = LVCMOS18;